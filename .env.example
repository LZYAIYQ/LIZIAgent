# ============================================================================
# LZAgent .env.example
#
# Copy this file to .env and fill in the values you need.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows PowerShell / cmd)
#
# Every entry is optional — the bot starts in echo-only mode if no LLM
# key is configured. See backend/core/config.py for the full Settings
# schema and additional advanced flags.
# ============================================================================

# ---- LLM (required for real replies; otherwise falls back to echo) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# ---- Optional intent router (cheap Flash model used to pre-filter skills) ----
# Pre-screens skill / knowledge-mode candidates before the main LLM call.
LZAGENT_ROUTER_LLM_ENABLED=false
LZAGENT_ROUTER_LLM_MODEL=

# ---- Memory ----
LZAGENT_MEMORY_MAX_ENTRIES=200
LZAGENT_MEMORY_MAX_ENTRY_CHARS=500

# ---- Tool safety ----
LZAGENT_TOOL_GUARDRAILS_HARD_STOP_ENABLED=true
LZAGENT_SKILL_GUARD_ENABLED=true
LZAGENT_SKILL_GUARD_STRICT_FOR_AGENT=true

# ---- Context compression ----
LZAGENT_CONTEXT_SUMMARY_ENABLED=true
LZAGENT_CONTEXT_SUMMARY_THRESHOLD_CHARS=49152

# ---- GraphRAG (LLM-driven knowledge graph extraction) ----
LZAGENT_GRAPH_LLM_ENABLED=true

# ---- MCP ----
LZAGENT_MCP_ENABLED=true

# ---- Web search (all optional; DuckDuckGo + Bing run with zero config) ----
TAVILY_API_KEY=
LZAGENT_SEARXNG_URL=

# ---- Google Scholar ----
# SerpAPI key (recommended, 100 free searches/month at https://serpapi.com)
SERPAPI_API_KEY=
# Proxy for scholarly fallback (e.g. http://host.docker.internal:7890)
LZAGENT_SCHOLAR_PROXY=

# ---- Backing services (defaults match docker-compose.yml) ----
DATABASE_URL=postgresql+psycopg://zlagent:zlagent@postgres:5432/zlagent
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=zlagent123
LZAGENT_REDIS_URL=redis://redis:6379/0

# ---- IM gateways (configure the ones you actually use) ----
# WeChat (custom in-house relay)
WEIXIN_BASE_URL=
# WeCom (企业微信) bot webhook
WECOM_BOT_WEBHOOK=
# Feishu (飞书) - supports file attachments
# Create app at https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---- Server ----
LZAGENT_HOST=0.0.0.0
LZAGENT_PORT=8020
LZAGENT_LOG_LEVEL=INFO
